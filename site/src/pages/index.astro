---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import ShowList from '../components/ShowList.astro';
import { withBase } from '../lib/base';

const homeImage = 'https://i.ytimg.com/vi/diGgRkFFGcM/maxresdefault.jpg';

const episodes = await getCollection('episodes');
const now = Date.now();
const latestThree = episodes
  .filter((ep) => ep.data.type === 'episode' && ep.data.releaseDate.getTime() <= now)
  .sort((a, b) => b.data.releaseDate.getTime() - a.data.releaseDate.getTime())
  .slice(0, 3);

const shows = await getCollection('shows');
const upcomingShows = shows
  .filter((s) => s.data.status === 'upcoming')
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 5);
---

<Layout title="Početna">
  <PageHeader
    title="Đorđe"
    titleAccent="Čvarkov."
    description="Putuje po Vojvodini i objašnjava stvari koje svi znaju, a niko ne priča."
    image={homeImage}
    imageAlt="Đorđe Čvarkov za stolom u kancelariji"
    caption="Kancelarija, ponedeljak ujutru."
    stamp="Jedini</br>zvanicni!"
  >
    <a href={withBase('/video')} class="btn btn-primary">Gledaj epizode</a>
    <a href={withBase('/predstave')} class="btn">Predstave</a>
  </PageHeader>

  {/* Ko je Đorđe — kratko */}
  <section id="pocetak" class="bg-paper py-20 sm:py-28">
    <div class="max-w-6xl mx-auto px-4 lg:px-6 grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20 items-center">
      <div>
        <span class="accent-dash" aria-hidden="true"></span>
        <h2 class="font-slab font-bold text-4xl sm:text-5xl leading-none text-ink">
          Ko je <span class="text-bordo">Đorđe?</span>
        </h2>
        <p class="text-lg leading-relaxed text-ink/75 mt-6 max-w-lg">
          Fiktivni komičarski lik koji obilazi sela Vojvodine i objašnjava svakodnevne stvari — direktno,
          sa mnogo šale i bez uvijanja.
        </p>
        <a href={withBase('/video')} class="link-more inline-block mt-8">Upoznaj ga kroz epizode →</a>
      </div>

      <figure class="moto-card">
        <p class="font-typewriter text-xs tracking-[0.2em] uppercase text-stone">Moto</p>
        <blockquote class="font-slab font-bold text-3xl sm:text-[2.4rem] leading-tight text-ink mt-3">
          „Ako ne znaš, pitaj. Ako znaš, <span class="text-bordo">objasni</span>.“
        </blockquote>
      </figure>
    </div>
  </section>

  {/* Najnoviji video */}
  {latestThree.length > 0 && (
    <section class="paper-dots border-t border-ink/10 py-20 sm:py-24">
      <div class="max-w-6xl mx-auto px-4 lg:px-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
          <div>
            <p class="font-typewriter text-sm uppercase tracking-[0.2em] text-stone mb-3">Najnovije</p>
            <h2 class="font-slab font-bold text-4xl sm:text-5xl leading-none text-ink">Najnoviji <span class="text-bordo">video</span></h2>
          </div>
          <a href={withBase('/video')} class="link-more self-start sm:self-auto">Svi video zapisi →</a>
        </div>
        <div class="video-tilt grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-8">
          {latestThree.map((episode) => <EpisodeCard episode={episode} />)}
        </div>
      </div>
    </section>
  )}

  {/* Predstave */}
  {upcomingShows.length > 0 && (
    <section class="bg-hay py-20 sm:py-24" style="--ticket-cut: var(--color-hay)">
      <div class="max-w-6xl mx-auto px-4 lg:px-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
          <div>
            <p class="font-typewriter text-sm uppercase tracking-[0.2em] text-stone mb-3">Uživo</p>
            <h2 class="font-slab font-bold text-4xl sm:text-5xl leading-none text-ink">Predstave</h2>
          </div>
          <a href={withBase('/predstave')} class="link-more self-start sm:self-auto">Svi termini →</a>
        </div>
        <ShowList shows={upcomingShows} />
      </div>
    </section>
  )}
</Layout>

<style>
  .moto-card {
    margin: 0;
    background: var(--color-cream);
    border: 1px solid var(--color-hay);
    padding: 2.2rem 2.2rem 2rem;
    transform: rotate(-1.5deg);
    box-shadow: 0 10px 24px rgb(36 28 21 / 0.1);
    background-image: repeating-linear-gradient(transparent 0 31px, rgb(122 31 46 / 0.12) 31px 32px);
  }
</style>
