---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SeasonTabs from '../../components/SeasonTabs.tsx';
import { slugify } from '../../lib/slugify';
import { withBase } from '../../lib/base';

export async function getStaticPaths() {
  const allSeries = await getCollection('series');

  return allSeries.map((entry) => {
    const slug = slugify(entry.data.title);
    return {
      params: { series: slug },
      props: { id: entry.id },
    };
  });
}

const { id } = Astro.props;
const seriesEntry = await getEntry('series', id);
const { title, description } = seriesEntry.data;

const allEpisodes = await getCollection('episodes');
const filtered = allEpisodes.filter((ep) => ep.data.series === title);

const episodeData = filtered.map((ep) => ({
  id: ep.id,
  title: ep.data.title,
  series: ep.data.series,
  season: ep.data.season,
  episodeNumber: ep.data.episodeNumber,
  region: ep.data.region,
  village: ep.data.village,
  releaseDate: ep.data.releaseDate.toISOString(),
  type: ep.data.type,
  youtubeUrl: ep.data.youtubeUrl,
  thumbnail: ep.data.thumbnail,
  description: ep.data.description,
}));
---

<Layout title={title} description={description}>
  <section class="paper-dots border-b border-ink/10">
    <div class="max-w-6xl mx-auto px-4 lg:px-6 pt-14 sm:pt-20 pb-12">
      <span class="accent-dash" aria-hidden="true"></span>
      <nav aria-label="Putanja" class="font-typewriter text-sm uppercase tracking-[0.2em] text-stone mb-4">
        <a href={withBase('/video')} class="text-bordo hover:text-ink transition-colors">Video</a>
        <span class="mx-2 text-stone/60" aria-hidden="true">/</span>
        <span>{title}</span>
      </nav>
      <h1 class="font-slab font-bold text-4xl sm:text-5xl lg:text-6xl leading-[1] text-ink max-w-4xl">{title}</h1>
      <p class="font-typewriter text-lg leading-relaxed text-stone mt-5 max-w-2xl">{description}</p>
    </div>
  </section>

  <section id="epizode" class="bg-paper py-20 sm:py-24 scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <SeasonTabs episodes={episodeData} client:load />
    </div>
  </section>
</Layout>
