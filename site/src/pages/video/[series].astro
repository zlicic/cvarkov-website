---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SeasonTabs from '../../components/SeasonTabs.tsx';
import { slugify } from '../../lib/slugify';

export async function getStaticPaths() {
  const allSeries = await getCollection('series');

  return allSeries.map((entry) => {
    const slug = slugify(entry.data.title);
    return {
      params: { series: slug },
      props: { id: entry.id },
    };
  });
}

const { id } = Astro.props;
const seriesEntry = await getEntry('series', id);
const { title, description } = seriesEntry.data;

const allEpisodes = await getCollection('episodes');
const filtered = allEpisodes.filter((ep) => ep.data.series === title);

const episodeData = filtered.map((ep) => ({
  id: ep.id,
  title: ep.data.title,
  series: ep.data.series,
  season: ep.data.season,
  episodeNumber: ep.data.episodeNumber,
  region: ep.data.region,
  village: ep.data.village,
  releaseDate: ep.data.releaseDate.toISOString(),
  type: ep.data.type,
  youtubeUrl: ep.data.youtubeUrl,
  thumbnail: ep.data.thumbnail,
  description: ep.data.description,
}));
---

<Layout title={title} description={description}>
  <section class="bg-hay py-16 sm:py-20">
    <div class="max-w-screen-2xl mx-auto px-4 lg:px-6">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-bordo mb-2">
        <a href="/video" class="hover:text-ink transition-colors text-bordo">Video</a>
        <span class="mx-2">/</span>
        {title}
      </p>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-ink mb-4">{title}</h1>
      <p class="text-lg text-ink/80 max-w-2xl">
        {description}
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-paper">
    <div class="max-w-screen-2xl mx-auto px-4 lg:px-6">
      <SeasonTabs episodes={episodeData} client:load />
    </div>
  </section>
</Layout>
