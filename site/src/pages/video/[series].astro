---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SeasonTabs from '../../components/SeasonTabs.tsx';
import { slugify } from '../../lib/slugify';
import { withBase } from '../../lib/base';

export async function getStaticPaths() {
  const allSeries = await getCollection('series');

  return allSeries.map((entry) => {
    const slug = slugify(entry.data.title);
    return {
      params: { series: slug },
      props: { id: entry.id },
    };
  });
}

const { id } = Astro.props;
const seriesEntry = await getEntry('series', id);
const { title, description, image } = seriesEntry.data;

const allEpisodes = await getCollection('episodes');
const filtered = allEpisodes.filter((ep) => ep.data.series === title);

const episodeData = filtered.map((ep) => ({
  id: ep.id,
  title: ep.data.title,
  series: ep.data.series,
  season: ep.data.season,
  episodeNumber: ep.data.episodeNumber,
  region: ep.data.region,
  village: ep.data.village,
  releaseDate: ep.data.releaseDate.toISOString(),
  type: ep.data.type,
  youtubeUrl: ep.data.youtubeUrl,
  thumbnail: ep.data.thumbnail,
  description: ep.data.description,
}));
---

<Layout title={title} description={description}>
  <PageHeader
    crumbs={[{ href: withBase('/video'), label: 'Video' }, { label: 'Serija' }]}
    title={title}
    description={description}
    image={image}
    imageAlt={title}
    caption={`— ${filtered.length} ${filtered.length % 10 === 1 && filtered.length % 100 !== 11 ? 'video' : 'videa'}`}
    stamp="Gledaj<br>redom!"
  >
    <a href="#epizode" class="btn btn-primary">Epizode</a>
    <a href={withBase('/video')} class="btn">Sve grupe</a>
  </PageHeader>

  <section id="epizode" class="bg-paper py-20 sm:py-24 scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <SeasonTabs episodes={episodeData} client:load />
    </div>
  </section>
</Layout>
