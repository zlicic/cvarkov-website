---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { slugify } from '../../lib/slugify';
import { withBase } from '../../lib/base';

const videoImage = 'https://img.youtube.com/vi/DY82l1h9BiQ/hqdefault.jpg';

const allSeries = await getCollection('series');
const episodes = await getCollection('episodes');

const countBySeries = new Map<string, number>();
for (const ep of episodes) {
  const title = ep.data.series;
  countBySeries.set(title, (countBySeries.get(title) ?? 0) + 1);
}

function videoLabel(count: number) {
  if (count === 1 || (count % 10 === 1 && count % 100 !== 11)) return 'video';
  return 'videa';
}

const seriesList = allSeries
  .map((entry) => ({
    slug: slugify(entry.data.title),
    title: entry.data.title,
    description: entry.data.description,
    image: entry.data.image,
    order: entry.data.order,
    count: countBySeries.get(entry.data.title) ?? 0,
  }))
  .sort((a, b) => a.order - b.order);
---

<Layout title="Video" description="Svi video zapisi Đorđa Čvarkova — serije, epizode i sadržaj iza scene.">
  <PageHeader
    title="Svi video"
    titleAccent="zapisi."
    description="Biraj grupu videa i gledaj po sezonama, ili pogledaj šta se dešavalo iza kamere."
    image={videoImage}
    imageAlt="Đorđe Čvarkov u kancelariji"
    caption="Poverljiva arhivska dokumenta."
    stamp="Zavedeno!"
  >
    {seriesList.slice(0, 2).map((s, i) => (
      <a href={withBase(`/video/${s.slug}`)} class:list={['btn', i === 0 && 'btn-primary']}>{s.title}</a>
    ))}
  </PageHeader>

  <section class="bg-paper py-20 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <div class="mb-12">
        <p class="font-typewriter text-sm uppercase tracking-[0.2em] text-stone mb-3">Kategorije</p>
        <h2 class="font-slab font-bold text-4xl sm:text-5xl leading-none text-ink">Biraj <span class="text-bordo">grupu</span></h2>
      </div>

      <div class="video-tilt grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 lg:gap-8">
        {seriesList.map((s) => (
          <article class="group">
            <a href={withBase(`/video/${s.slug}`)} class="video-print" aria-label={s.title}>
              <span class="video-badge">{s.count} {videoLabel(s.count)}</span>
              <img src={s.image} alt="" class="aspect-[4/3]" loading="lazy" decoding="async" />
              <div class="video-bar">
                <span>Grupa</span>
                <span>Otvori →</span>
              </div>
            </a>
            <h2 class="font-slab font-bold text-3xl leading-tight text-ink mt-5">
              <a href={withBase(`/video/${s.slug}`)} class="hover:text-bordo transition-colors">{s.title}</a>
            </h2>
            <p class="text-[0.95rem] leading-relaxed text-stone mt-2 line-clamp-3">{s.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
