---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const contactImage =
  'https://external-content.duckduckgo.com/iu/?u=https%3A%2F%2Ftse1.mm.bing.net%2Fth%2Fid%2FOIP.YXBp7hYLBqjuWeCjmoIhvQHaEK%3Fpid%3DApi&f=1&ipt=f7b449ab6f7ee93b9050174803eb6a90ef7c01b799aef31324859b46489392e6&ipo=images';

const phoneIcon = '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>';
const mailIcon = '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>';

const kontakti = [
  { label: 'Telefon', value: '+381 65 1234 56789', href: 'tel:+38165123456789', note: 'Čvarkov tim', action: 'Pozovi', icon: phoneIcon },
  { label: 'Generalne informacije', value: 'info@cvarkov.com', href: 'mailto:info@cvarkov.com', note: 'Opšta pitanja i poruke fanova', action: 'Pošalji mejl', icon: mailIcon },
  { label: 'Saradnja', value: 'saradnja@cvarkov.com', href: 'mailto:saradnja@cvarkov.com', note: 'Za predstave, projekte i medijska pitanja', action: 'Pošalji mejl', icon: mailIcon },
];

const upit = ['Datum i grad', 'Prostor i kapacitet sale', 'Tip događaja', 'Kontakt osobu i telefon'];
---

<Layout title="Kontakt" description="Kontakt podaci i saradnja sa Đorđem Čvarkovom.">
  <PageHeader
    title="Javite se"
    titleAccent="Čvarkovu."
    description="Kontakt podaci za predstave, saradnju i medijska pitanja."
    image={contactImage}
    imageAlt="Đorđe Čvarkov drži telefon"
    caption="— Glavni Arghivator, Đorđe Čvarkov je pri vezi.“"
    stamp="Zovite<br>Čvarkova!"
  >
    <a href="#zakazivanje" class="btn btn-primary">Zakaži predstavu</a>
    <a href="mailto:info@cvarkov.com" class="btn">Pošalji mejl</a>
  </PageHeader>

  <section class="bg-paper py-20 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <dl class="grid gap-6 md:grid-cols-3">
        {kontakti.map((k) => (
          <div class="ticket">
            <dt class="ticket-label font-typewriter">
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={k.icon} />
              {k.label}
            </dt>
            <dd class="font-slab font-bold text-2xl text-ink break-words">
              <a href={k.href} class="hover:text-bordo transition-colors">{k.value}</a>
            </dd>
            <dd class="text-sm text-stone mt-1">{k.note}</dd>
            <dd class="ticket-actions font-typewriter">
              <a href={k.href}>{k.action} →</a>
              <button type="button" data-copy={k.value}>Kopiraj</button>
            </dd>
          </div>
        ))}
      </dl>

      <div id="zakazivanje" class="scroll-mt-28 mt-16 sm:mt-20 border-2 border-ink bg-cream p-8 sm:p-12 grid gap-10 lg:grid-cols-2 items-center">
        <div>
          <h2 class="font-slab font-bold text-4xl leading-none text-ink">Zakažite <span class="text-bordo">predstavu</span></h2>
          <p class="mt-4 text-stone leading-relaxed">
            Dovodimo Čvarkova u vaš grad — dom kulture, festival, firmu ili privatni događaj.
            Pošaljite nam osnovne informacije i javićemo se sa ponudom.
          </p>
          <a href="mailto:saradnja@cvarkov.com?subject=Upit%20za%20predstavu" class="btn btn-primary mt-7">Pošalji upit →</a>
        </div>
        <ol class="upit-list font-typewriter text-lg text-ink">
          {upit.map((s) => <li>{s}</li>)}
        </ol>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        const old = btn.textContent;
        btn.textContent = 'Kopirano ✓';
        setTimeout(() => (btn.textContent = old), 1500);
      } catch {}
    });
  });
</script>

<style>
  .ticket-label {
    display: flex; align-items: center; gap: 0.55rem;
    font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-stone);
    margin-bottom: 2.4rem;
  }
  .ticket-label svg {
    width: 18px; height: 18px; fill: none; stroke: var(--color-bordo); stroke-width: 2;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .ticket-actions {
    display: flex; gap: 1.1rem; margin-top: 1.3rem;
    font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase;
  }
  .ticket-actions a { color: var(--color-bordo); }
  .ticket-actions a:hover { color: var(--color-bordo-dark); }
  .ticket-actions button { color: var(--color-stone); cursor: pointer; text-transform: inherit; letter-spacing: inherit; }
  .ticket-actions button:hover { color: var(--color-ink); }
  .upit-list { list-style: none; counter-reset: n; margin: 0; padding: 0; }
  .upit-list li { counter-increment: n; display: flex; gap: 0.9rem; padding: 0.8rem 0; border-bottom: 1px dashed var(--color-hay); }
  .upit-list li::before { content: "0" counter(n); color: var(--color-bordo); }
</style>
