---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ShowList from '../components/ShowList.astro';

const shows = await getCollection('shows');
const sorted = shows.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const upcoming = sorted.filter((s) => s.data.status === 'upcoming' || s.data.status === 'declined');

const showImage = 'https://i.ytimg.com/vi/ImFitAV4vo4/maxresdefault.jpg';
---

<Layout title="Predstave" description="Najave predstava Đorđa Čvarkova — termini, lokacije i karte.">
  <PageHeader
    eyebrow="Uživo"
    title="Predstave"
    description="Termini, lokacije i karte za predstave Đorđa Čvarkova."
    image={showImage}
    imageAlt="Đorđe Čvarkov na sceni"
  />

  <section class="py-16 sm:py-24 bg-paper">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      {upcoming.length > 0 ? (
        <div class="mb-16">
          <ShowList shows={upcoming} title="Naredni nastupi" />
        </div>
      ) : (
        <p class="text-center text-lg text-ink/80 mb-16">
          Trenutno nema najavljenih predstava.
        </p>
      )}

      <div class="bg-hay border border-ink/10 rounded-2xl p-8 sm:p-12 text-center">
        <h2 class="font-display text-2xl sm:text-3xl text-ink mb-3">Pozovi me u tvoj grad</h2>
        <p class="text-ink/70 max-w-xl mx-auto mb-6">
          Nemaš datum u svom gradu? Ako želiš da organizujemo predstavu — piši mi.
        </p>
        <a
          href="/kontakt"
          class="inline-flex items-center gap-2 px-6 py-3 bg-bordo text-cream text-sm font-bold uppercase tracking-wide rounded hover:bg-bordo-dark transition-colors"
        >
          Pošalji upit
        </a>
      </div>
    </div>
  </section>

</Layout>
