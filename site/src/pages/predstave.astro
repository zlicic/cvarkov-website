---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ShowList from '../components/ShowList.astro';

const shows = await getCollection('shows');
const upcoming = shows
  .filter((s) => s.data.status === 'upcoming' || s.data.status === 'declined')
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const showImage = 'https://i.ytimg.com/vi/ImFitAV4vo4/maxresdefault.jpg';

const terminLabel = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'termin' : 'termina');

const upit = ['Datum i grad', 'Prostor i kapacitet sale', 'Tip događaja', 'Kontakt osobu i telefon'];
---

<Layout title="Predstave" description="Najave predstava Đorđa Čvarkova — termini, lokacije i karte.">
  <PageHeader
    eyebrow="Uživo"
    title="Čvarkov"
    titleAccent="uživo."
    description="Termini, lokacije i karte za predstave Đorđa Čvarkova."
    image={showImage}
    imageAlt="Đorđe Čvarkov sa nogama na stolu"
    caption="— „Samo da izujem cipele…“"
    stamp="Uživo<br>na<br>sceni!"
  >
    <a href="#nastupi" class="btn btn-primary">Naredni nastupi</a>
    <a href="#pozovi" class="btn">Pozovi me u grad</a>
  </PageHeader>

  <section class="bg-paper py-20 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 lg:px-6">
      <div id="nastupi" class="scroll-mt-28 flex items-end justify-between gap-4 mb-10">
        <h2 class="font-slab font-bold text-4xl sm:text-5xl leading-none text-ink">Naredni <span class="text-bordo">nastupi</span></h2>
        {upcoming.length > 0 && (
          <span class="font-typewriter text-stone">{upcoming.length} {terminLabel(upcoming.length)}</span>
        )}
      </div>

      {upcoming.length > 0 ? (
        <ShowList shows={upcoming} />
      ) : (
        <p class="font-typewriter text-lg text-stone border-2 border-dashed border-hay p-10 text-center">
          Trenutno nema najavljenih predstava. Pozovi me u svoj grad!
        </p>
      )}

      <div id="pozovi" class="scroll-mt-28 mt-20 border-2 border-ink bg-cream p-8 sm:p-12 grid gap-10 lg:grid-cols-[1.2fr_1fr] items-center">
        <div>
          <h2 class="font-slab font-bold text-4xl leading-none text-ink">Pozovi me u <span class="text-bordo">tvoj grad</span></h2>
          <p class="mt-4 text-stone leading-relaxed">
            Nemaš datum u svom gradu? Ako želiš da organizujemo predstavu — piši mi.
            Dom kulture, festival, firma ili privatni događaj.
          </p>
          <a href="/kontakt" class="btn btn-primary mt-7">Pošalji upit →</a>
        </div>
        <ol class="upit-list font-typewriter text-lg text-ink">
          {upit.map((s) => <li>{s}</li>)}
        </ol>
      </div>
    </div>
  </section>
</Layout>

<style>
  .upit-list { list-style: none; counter-reset: n; margin: 0; padding: 0; }
  .upit-list li { counter-increment: n; display: flex; gap: 0.9rem; padding: 0.8rem 0; border-bottom: 1px dashed var(--color-hay); }
  .upit-list li::before { content: "0" counter(n); color: var(--color-bordo); }
</style>
