---
import SocialLinks from './SocialLinks.astro';
---

<footer class="bg-ink text-cream py-12">
  <div class="max-w-screen-2xl mx-auto px-4 lg:px-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-8">
      <div class="flex items-center gap-4">
        <img src="/logo.png" alt="" class="h-16 w-auto opacity-90" width="64" height="64" />
        <div>
          <p class="font-display text-xl tracking-wide">ĐORĐE CVARKOV</p>
          <p class="text-sm text-cream/70 mt-0.5">Zvanični sajt</p>
        </div>
      </div>

      <SocialLinks class="justify-center" />
    </div>

    <div class="mt-10 pt-6 border-t border-cream/10 text-center text-xs text-cream/50">
      <p>© {new Date().getFullYear()} Đorđe Cvarkov. Sva prava zadržana.</p>
    </div>
  </div>
</footer>
