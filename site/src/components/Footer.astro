---
import SocialLinks from './SocialLinks.astro';

const nav = [
  { href: '/', label: 'Početna' },
  { href: '/video', label: 'Video' },
  { href: '/predstave', label: 'Predstave' },
  { href: '/kontakt', label: 'Kontakt' },
];
---

<footer class="bg-ink text-cream relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 lg:px-6 pt-16 pb-10">
    <div class="grid gap-12 md:grid-cols-[auto_1fr_auto] md:items-center">
      <a
        href="/"
        class="mx-auto md:mx-0 block h-[124px] w-[124px] rounded-full overflow-hidden ring-2 ring-cream/20 ring-offset-4 ring-offset-ink -rotate-6 hover:rotate-0 transition-transform"
        aria-label="Đorđe Čvarkov — zvanični sajt"
      >
        <img src="/logo.png" alt="Đorđe Čvarkov" class="h-full w-full object-cover" width="124" height="124" />
      </a>

      <div class="text-center md:text-left">
        <p class="font-typewriter text-xl sm:text-2xl leading-snug text-cream">
          „Ako ne znaš, pitaj. Ako znaš, objasni.“
        </p>
        <!-- <p class="text-cream/60 mt-3 max-w-lg mx-auto md:mx-0">
          Zaprati me i ne propusti najave za predstave, novu sezonu i druge projekte.
        </p> -->
      </div>

      <SocialLinks variant="light" class="justify-center" />
    </div>

    <hr class="border-0 border-t-2 border-dashed border-cream/15 mt-12 mb-8" />

    <div class="flex flex-col-reverse gap-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-typewriter text-xs tracking-[0.15em] uppercase text-cream/45 text-center sm:text-left">
        © {new Date().getFullYear()} Đorđe Čvarkov · Sva prava zadržana
      </p>
      <ul class="flex justify-center gap-6">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="font-typewriter text-sm uppercase tracking-wide text-cream/70 hover:text-cream transition-colors">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
