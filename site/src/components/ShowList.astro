---
import type { CollectionEntry } from 'astro:content';

interface Props {
  shows: CollectionEntry<'shows'>[];
  title?: string;
}

const { shows, title = 'Naredni nastupi' } = Astro.props;

const TICKETS_URL = 'https://new.gigstix.com/';

function formatDateParts(date: Date) {
  const weekday = date.toLocaleDateString('sr-Latn-RS', { weekday: 'short' }).replace('.', '');
  const day = date.getDate();
  const month = date.toLocaleDateString('sr-Latn-RS', { month: 'short' }).replace('.', '');
  const year = date.getFullYear();
  return { weekday, day, month, year };
}

function formatInfo(show: CollectionEntry<'shows'>) {
  const parts = [show.data.venue, show.data.city, show.data.time].filter(Boolean);
  return parts.join(' • ');
}

const isDeclined = (show: CollectionEntry<'shows'>) => show.data.status === 'declined';
---

<div class="space-y-0">
  {title && <h2 class="font-display text-3xl sm:text-4xl text-ink mb-8">{title}</h2>}
  <ul class="divide-y divide-ink/10 border-t border-ink/10">
    {shows.map((show) => {
      const { weekday, day, month, year } = formatDateParts(show.data.date);
      const declined = isDeclined(show);
      return (
        <li class={`py-5 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 ${declined ? 'opacity-60 bg-hay/30 border-l-4 border-bordo pl-3 sm:pl-4' : ''}`}>
          <div class="flex items-start sm:items-center gap-3 min-w-[6.5rem]">
            <span class={`font-display text-4xl sm:text-5xl font-bold leading-none ${declined ? 'text-stone' : 'text-ink'}`}>{day}</span>
            <div class="flex flex-col text-xs font-bold uppercase tracking-wider text-stone leading-tight">
              <span>{month}</span>
              <span>{year}</span>
              <span class="text-ink/60 normal-case font-medium">{weekday}</span>
            </div>
          </div>

          <div class="flex-1 min-w-0">
            <h3 class={`font-display text-xl sm:text-2xl truncate ${declined ? 'text-stone line-through' : 'text-ink'}`}>{show.data.title}</h3>
            <p class="text-sm text-stone">{formatInfo(show)}</p>
          </div>

          {declined ? (
            <span class="self-start sm:self-center inline-flex items-center gap-2 px-5 py-2.5 bg-bordo/10 text-bordo text-sm font-bold uppercase tracking-wide rounded">
              Otkazano
            </span>
          ) : (
            <a
              href={TICKETS_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="self-start sm:self-center inline-flex items-center gap-2 px-5 py-2.5 bg-bordo text-cream text-sm font-bold uppercase tracking-wide rounded hover:bg-bordo-dark transition-colors"
            >
              Karte
            </a>
          )}
        </li>
      );
    })}
  </ul>
</div>
