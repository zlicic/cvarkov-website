---
import type { CollectionEntry } from 'astro:content';

interface Props {
  shows: CollectionEntry<'shows'>[];
}

const { shows } = Astro.props;

const TICKETS_URL = 'https://new.gigstix.com/';

function formatDateParts(date: Date) {
  const weekday = date.toLocaleDateString('sr-Latn-RS', { weekday: 'long' });
  const day = String(date.getDate()).padStart(2, '0');
  const month = date.toLocaleDateString('sr-Latn-RS', { month: 'short' }).replace('.', '');
  const year = date.getFullYear();
  return { weekday, day, month, year };
}

function formatInfo(show: CollectionEntry<'shows'>) {
  return [show.data.venue, show.data.city, show.data.time].filter(Boolean).join(' · ');
}
---

<ul class="grid gap-5">
  {shows.map((show) => {
    const { weekday, day, month, year } = formatDateParts(show.data.date);
    const declined = show.data.status === 'declined';
    return (
      <li class:list={['show-ticket', declined && 'is-declined']}>
        <div class="show-date">
          <span class="font-slab font-bold text-5xl leading-[0.9] text-bordo">{day}</span>
          <span class="font-typewriter uppercase tracking-[0.15em] text-sm mt-1.5">{month} {year}</span>
          <span class="text-xs text-stone mt-0.5">{weekday}</span>
        </div>

        <div class="show-info">
          <h3 class:list={['font-slab font-bold text-2xl sm:text-[1.75rem] leading-tight text-ink', declined && 'line-through text-stone']}>
            {show.data.title}
          </h3>
          <p class="font-typewriter text-stone mt-1.5">{formatInfo(show)}</p>
        </div>

        <div class="show-action">
          {declined ? (
            <span class="font-typewriter uppercase tracking-wide text-sm text-bordo border-2 border-bordo px-4 py-2 inline-block -rotate-3">Otkazano</span>
          ) : (
            <a href={TICKETS_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Karte →</a>
          )}
        </div>
      </li>
    );
  })}
</ul>

<style>
  .show-ticket {
    position: relative;
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    align-items: center;
    background: var(--color-cream);
    border: 1px solid var(--color-hay);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .show-ticket:hover {
    transform: translateY(-3px);
    border-color: var(--color-bordo);
    box-shadow: 0 10px 24px rgb(36 28 21 / 0.12);
  }
  .show-ticket.is-declined { opacity: 0.65; }
  .show-ticket.is-declined:hover { transform: none; box-shadow: none; border-color: var(--color-hay); }

  .show-date {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.4rem 0.5rem;
    border-right: 2px dashed var(--color-hay);
    align-self: stretch;
    justify-content: center;
  }
  /* zasečeni polukrugovi na perforaciji */
  .show-date::before,
  .show-date::after {
    content: "";
    position: absolute;
    right: -11px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--ticket-cut, var(--color-paper));
    border: 1px solid var(--color-hay);
  }
  .show-date::before { top: -11px; }
  .show-date::after { bottom: -11px; }

  .show-info { padding: 1.4rem 2rem; min-width: 0; }
  .show-action { padding: 0 2rem; }

  @media (max-width: 640px) {
    .show-ticket { grid-template-columns: 6.5rem 1fr; }
    .show-info { padding: 1.2rem 1.2rem; }
    .show-action { grid-column: 1 / -1; padding: 1rem 1.2rem; border-top: 2px dashed var(--color-hay); }
    .show-date::before, .show-date::after { display: none; }
  }
</style>
