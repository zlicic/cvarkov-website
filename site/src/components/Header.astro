---
import { withBase } from '../lib/base';

const homeHref = withBase('/');
const leftNav = [
  { href: homeHref, label: 'Početna' },
  { href: withBase('/video'), label: 'Video' },
];

const rightNav = [
  { href: withBase('/predstave'), label: 'Predstave' },
  { href: withBase('/kontakt'), label: 'Kontakt' },
];

const mobileNav = [...leftNav, ...rightNav];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-cream/95 backdrop-blur border-b border-ink/10">
  <div class="max-w-7xl mx-auto px-4 lg:px-6">
    <nav
      class="flex items-center justify-between h-18 md:grid md:grid-cols-[1fr_auto_1fr]"
      aria-label="Glavna navigacija"
    >
      {/* Mobile: logo left */}
      <a
        href={homeHref}
        class="md:hidden h-14 w-14 shrink-0 overflow-hidden rounded-full border-2 border-cream bg-cream shadow-md focus-visible:outline-offset-4"
        aria-label="Đorđe Čvarkov — zvanični sajt"
      >
        <img
          src={withBase('logo.png')}
          alt="Đorđe Čvarkov"
          class="h-full w-full object-cover"
          width="56"
          height="56"
        />
      </a>

      {/* Left: Početna + Video */}
      <div class="hidden md:flex items-center justify-start md:justify-end md:pr-8 mb-4">
        <ul class="flex items-center gap-8">
          {leftNav.map((item) => {
            const isActive = current === item.href || (item.href !== homeHref && current.startsWith(`${item.href}/`));
            return (
              <li>
                <a
                  href={item.href}
                  class={`relative py-1 text-base font-typewriter tracking-wide uppercase transition-colors after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:rounded-full after:bg-bordo after:transition-opacity ${
                    isActive ? 'text-bordo after:opacity-100' : 'text-ink hover:text-bordo after:opacity-0'
                  }`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      {/* Desktop: centered logo */}
      <a
        href={homeHref}
        class="hidden md:block h-[96px] w-auto shrink-0 overflow-hidden rounded-full border-2 border-cream bg-cream shadow-md focus-visible:outline-offset-4"
        aria-label="Đorđe Čvarkov — zvanični sajt"
      >
        <img
          src={withBase('logo.png')}
          alt="Đorđe Čvarkov"
          class="h-full w-full object-cover"
          width="96"
          height="96"
        />
      </a>

      {/* Right: Predstave + Kontakt */}
      <div class="flex items-center justify-end md:justify-start md:pl-8 mb-4">
        <ul class="hidden md:flex items-center gap-8">
          {rightNav.map((item) => {
            const isActive = current === item.href || (item.href !== homeHref && current.startsWith(`${item.href}/`));
            return (
              <li>
                <a
                  href={item.href}
                  class={`relative py-1 text-base font-typewriter tracking-wide uppercase transition-colors after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:rounded-full after:bg-bordo after:transition-opacity ${
                    isActive ? 'text-bordo after:opacity-100' : 'text-ink hover:text-bordo after:opacity-0'
                  }`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>

        <details class="md:hidden group" id="mobile-menu">
          <summary
            class="list-none p-3 mt-3 text-ink cursor-pointer w-fit"
            aria-label="Otvori meni"
          >
            <svg class="group-open:hidden" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            <svg class="hidden group-open:block" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </summary>
          <div class="absolute top-18 left-0 right-0 bg-cream border-b border-ink/10 px-4 py-5 shadow-xl">
            <ul class="flex flex-col gap-4">
              {mobileNav.map((item) => {
                const isActive = current === item.href || (item.href !== homeHref && current.startsWith(`${item.href}/`));
                return (
                  <li>
                    <a
                      href={item.href}
                      class={`block text-base font-typewriter uppercase tracking-wide ${
                        isActive ? 'text-bordo' : 'text-ink/80 hover:text-bordo'
                      }`}
                      aria-current={isActive ? 'page' : undefined}
                      onclick="document.getElementById('mobile-menu').removeAttribute('open')"
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </details>
      </div>
    </nav>
  </div>
</header>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
