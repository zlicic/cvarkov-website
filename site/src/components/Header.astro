---
import SocialLinks from './SocialLinks.astro';

const nav = [
  { href: '/', label: 'Početna' },
  { href: '/video', label: 'Video' },
  { href: '/predstave', label: 'Predstave' },
  { href: '/kontakt', label: 'Kontakt' },
];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-cream/95 backdrop-blur border-b border-ink/10 mb-11">
  <div class="max-w-screen-2xl mx-auto">
    <nav
      class="flex items-center justify-between h-24"
      aria-label="Glavna navigacija"
    >
      {/* Left: desktop nav */}
      <ul class="hidden md:flex items-center gap-6 justify-start pl-4 lg:pl-6">
        {nav.map((item) => {
          const isActive = current === item.href || current.startsWith(`${item.href}/`);
          return (
            <li>
              <a
                href={item.href}
                class={`relative py-1 text-sm font-bold tracking-wide uppercase transition-colors after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:rounded-full after:bg-bordo after:transition-opacity ${
                  isActive ? 'text-bordo after:opacity-100' : 'text-ink hover:text-bordo after:opacity-0'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      {/* Left: mobile menu toggle */}
      <details class="md:hidden group" id="mobile-menu">
        <summary
          class="list-none p-2 text-ink cursor-pointer w-fit"
          aria-label="Otvori meni"
        >
          <svg class="group-open:hidden" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          <svg class="hidden group-open:block" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </summary>
        <div class="absolute top-24 left-0 right-0 bg-cream border-b border-ink/10 px-4 py-5 shadow-xl">
          <ul class="flex flex-col gap-4">
            {nav.map((item) => {
              const isActive = current === item.href || current.startsWith(`${item.href}/`);
              return (
                <li>
                  <a
                    href={item.href}
                    class={`block text-base font-semibold uppercase tracking-wide ${
                      isActive ? 'text-bordo' : 'text-ink/80 hover:text-bordo'
                    }`}
                    aria-current={isActive ? 'page' : undefined}
                    onclick="document.getElementById('mobile-menu').removeAttribute('open')"
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
            <li class="pt-3 border-t border-ink/10">
              <SocialLinks variant="header" />
            </li>
          </ul>
        </div>
      </details>

      {/* Center: logo */}
      <a
        href="/"
        class="absolute left-1/2 top-0 h-[140px] w-auto -translate-x-1/2 overflow-hidden rounded-full border-4 border-cream bg-cream shadow-xl focus-visible:outline-offset-4"
        aria-label="Đorđe Cvarkov — zvanični sajt"
      >
        <img
          src="/logo.png"
          alt="Đorđe Cvarkov"
          class="h-full w-full object-cover"
          width="128"
          height="128"
        />
      </a>

      {/* Right: socials */}
      <div class="hidden md:flex items-center justify-end">
        <SocialLinks variant="header" />
      </div>
    </nav>
  </div>
</header>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
