---
import type { CollectionEntry } from 'astro:content';
import { slugify } from '../lib/slugify';

interface Props {
  episode: CollectionEntry<'episodes'>;
}

const { episode } = Astro.props;
const { title, series, season, episodeNumber, region, village, releaseDate, thumbnail, description, type } = episode.data;

const episodeHref = `/video/${slugify(series)}/${slugify(title)}`;

const isReleased = releaseDate.getTime() <= Date.now();
const canWatch = type === 'episode' && isReleased;
const dateLabel = releaseDate.toLocaleDateString('sr-Latn-RS', { day: 'numeric', month: 'long', year: 'numeric' });

const badge = type === 'season-announcement'
  ? 'Najava'
  : type === 'teaser'
    ? 'Sledeća epizoda'
    : `S${season} · E${episodeNumber}`;

const Tag = canWatch ? 'a' : 'div';
---

<article class="group">
  <Tag href={canWatch ? episodeHref : undefined} class="video-print" aria-label={canWatch ? `Gledaj: ${title}` : undefined}>
    <span class="video-badge">{badge}</span>
    {thumbnail ? (
      <img src={thumbnail} alt={`Naslovna slika epizode ${title}`} class="aspect-video" loading="lazy" decoding="async" />
    ) : (
      <div class="aspect-video bg-hay flex items-center justify-center">
        <span class="font-slab font-bold text-xl text-stone">Uskoro</span>
      </div>
    )}
    {canWatch && <span class="video-play" aria-hidden="true" />}
    <div class="video-bar">
      <span>{series}</span>
      <span>{canWatch ? 'Gledaj →' : `Premijera ${dateLabel}`}</span>
    </div>
  </Tag>

  <h3 class="font-slab font-bold text-2xl leading-tight text-ink mt-5 line-clamp-2">
    {canWatch ? <a href={episodeHref} class="hover:text-bordo transition-colors">{title}</a> : title}
  </h3>
  <p class="font-typewriter text-sm uppercase tracking-[0.08em] text-bordo mt-2">
    {region}{village ? ` · ${village}` : ''}
  </p>
  <p class="text-[0.95rem] leading-relaxed text-stone mt-2 line-clamp-3">{description}</p>
</article>
