---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
}

const { eyebrow, title, description, image, imageAlt = '' } = Astro.props;
---

<section
  class:list={[
    'relative py-16 sm:py-24',
    image && 'min-h-[480px] flex items-center bg-cover bg-center bg-no-repeat',
  ]}
  style={image ? `background-image: url('${image}')` : undefined}
  aria-label={imageAlt}
>
  {
    image && (
      <div
        class="absolute inset-0 bg-gradient-to-r from-ink/85 via-ink/55 to-ink/30"
        aria-hidden="true"
      />
    )
  }

  <div class="max-w-7xl mx-auto px-4 lg:px-6 relative z-10 w-full">
    <p
      class:list={[
        'text-sm uppercase tracking-[0.2em] mb-3',
        image ? 'text-cream/70' : 'text-stone',
      ]}
    >
      {eyebrow}
    </p>
    <h1
      id="page-title"
      class:list={[
        'font-typewriter text-4xl sm:text-5xl lg:text-6xl mb-5 leading-tight',
        image ? 'text-cream' : 'text-ink',
      ]}
    >
      {title}
    </h1>
    <p
      class:list={[
        'text-lg sm:text-xl max-w-2xl leading-relaxed',
        image ? 'text-cream/80' : 'text-ink/70',
      ]}
    >
      {description}
    </p>
  </div>
</section>
