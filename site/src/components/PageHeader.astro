---
interface Props {
  /** Prvi red naslova (tamna boja) */
  title: string;
  /** Drugi red naslova (bordo) */
  titleAccent?: string;
  description: string;
  image: string;
  imageAlt?: string;
  /** Potpis ispod fotografije */
  caption?: string;
  /** Tekst u pečatu; <br> je dozvoljen */
  stamp?: string;
  /** Putanja (breadcrumbs) iznad naslova */
  crumbs?: { href?: string; label: string }[];
}

const { title, titleAccent, description, image, imageAlt = '', caption, stamp, crumbs } = Astro.props;
---

<section class="paper-dots border-b border-ink/10 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 lg:px-6 pt-4 pb-16 sm:pt-10 sm:pb-24 grid gap-14 lg:gap-16 lg:grid-cols-[1fr_1.05fr] items-center">
    <div>
        <nav aria-label="Putanja" class="font-typewriter text-sm uppercase tracking-[0.2em] text-stone mb-3">
          {crumbs && crumbs.map((c, i) => (
            <>
              {i > 0 && <span class="mx-2 text-stone/60" aria-hidden="true">/</span>}
              {c.href ? <a href={c.href} class="text-bordo hover:text-ink transition-colors">{c.label}</a> : <span>{c.label}</span>}
            </>
          ))}
        </nav>
      <h1 id="page-title" class="font-slab font-bold text-5xl sm:text-6xl lg:text-7xl leading-[0.95] text-ink">
        {title}
        {titleAccent && (<><br /><span class="text-bordo">{titleAccent}</span></>)}
      </h1>
      <p class="font-typewriter text-lg leading-relaxed text-stone mt-6 max-w-md">{description}</p>
      {Astro.slots.has('default') && (
        <div class="mt-8 flex flex-wrap gap-3">
          <slot />
        </div>
      )}
    </div>

    <figure class="photo-print justify-self-center lg:justify-self-end">
      <span class="photo-tape" aria-hidden="true"></span>
      <div class="photo-frame">
        <img src={image} alt={imageAlt} width="1080" height="675" loading="eager" decoding="async" />
        {caption && <figcaption>{caption}</figcaption>}
      </div>
      {stamp && <span class="stamp" aria-hidden="true" set:html={stamp} />}
    </figure>
  </div>
</section>
