---
import SocialLinks from './SocialLinks.astro';
---

<footer class="bg-ink text-cream py-16">
  <div class="max-w-7xl mx-auto px-4 lg:px-6 flex flex-col items-center text-center">
    <a
      href="/"
      class="h-[120px] w-auto overflow-hidden rounded-full border-2 border-cream/20 mb-8 focus-visible:outline-offset-4"
      aria-label="Đorđe Čvarkov — zvanični sajt"
    >
      <img
        src="/logo.png"
        alt="Đorđe Čvarkov"
        class="h-full w-full object-cover opacity-90"
        width="120"
        height="120"
      />
    </a>

    <h3 class="font-display text-3xl text-cream mb-3">Budi među prvima</h3>
    <p class="text-cream/70 max-w-xl mb-6">
      Zaprati me na društvenim mrežama i ne propusti najave za predstave, novu sezonu i druge projekte.
    </p>

    <SocialLinks variant="light" class="justify-center mb-10" />

    <hr class="w-full border-cream/20 mb-10" />

    <p class="text-xs text-cream/50">
      © {new Date().getFullYear()} Đorđe Čvarkov. Sva prava zadržana.
    </p>
  </div>
</footer>
