---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { slugify } from '../../../lib/slugify';
import { getYouTubeEmbedUrl } from '../../../lib/youtube';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes');
  const videoEpisodes = episodes.filter((entry) => entry.data.type === 'episode');

  return videoEpisodes.map((entry) => {
    const seriesSlug = slugify(entry.data.series);
    const episodeSlug = slugify(entry.data.title);

    return {
      params: { series: seriesSlug, episode: episodeSlug },
      props: { id: entry.id },
    };
  });
}

const { id } = Astro.props;
const entry = await getEntry('episodes', id);
const {
  title,
  series,
  season,
  episodeNumber,
  region,
  village,
  releaseDate,
  youtubeUrl,
  description,
  body,
} = entry.data;

const seriesSlug = slugify(series);
const embedUrl = getYouTubeEmbedUrl(youtubeUrl);
const isReleased = releaseDate.getTime() <= Date.now();

const dateLabel = releaseDate.toLocaleDateString('sr-Latn-RS', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={`${title} | ${series}`} description={description}>
  <section class="bg-hay py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-bordo mb-2">
        <a href="/video" class="hover:text-ink transition-colors text-bordo">Video</a>
        <span class="mx-2">/</span>
        <a href={`/video/${seriesSlug}`} class="hover:text-ink transition-colors text-bordo">{series}</a>
        <span class="mx-2">/</span>
        <span class="text-ink/70">Epizoda</span>
      </p>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl text-ink mb-4 max-w-4xl">
        {title}
      </h1>
      <p class="text-lg text-ink/80 max-w-2xl">
        {description}
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16 bg-paper">
    <div class="max-w-7xl mx-auto px-4 lg:px-6">
      {isReleased && embedUrl ? (
        <div class="space-y-6">
          <div class="relative w-full aspect-video bg-stone/10 rounded-2xl overflow-hidden shadow-xl">
            <iframe
              src={embedUrl}
              title={title}
              class="absolute inset-0 w-full h-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="text-sm text-stone uppercase tracking-wider font-bold">
              Sezona {season} • {episodeNumber === 0 ? 'Najava' : `Epizoda ${episodeNumber}`}
            </div>
          </div>
        </div>
      ) : (
        <div class="text-center py-16 bg-hay rounded-2xl">
          <p class="text-2xl font-display text-ink mb-2">Premijera {dateLabel}</p>
          <p class="text-ink/70">Epizoda će biti dostupna na dan premijere.</p>
        </div>
      )}

      <div class="mt-10 grid lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2 prose prose-lg prose-stone max-w-none">
          {body ? <p class="whitespace-pre-line">{body}</p> : null}
        </div>

        <aside class="space-y-6">
          <div class="bg-cream border border-ink/10 rounded-xl p-6">
            <h2 class="font-display text-xl text-ink mb-4">Detalji</h2>
            <dl class="space-y-3 text-sm">
              <div>
                <dt class="text-stone uppercase tracking-wider font-bold">Serija</dt>
                <dd class="text-ink"><a href={`/video/${seriesSlug}`} class="text-bordo hover:text-ink transition-colors">{series}</a></dd>
              </div>
              <div>
                <dt class="text-stone uppercase tracking-wider font-bold">Sezona / epizoda</dt>
                <dd class="text-ink">{season} / {episodeNumber === 0 ? 'Najava' : episodeNumber}</dd>
              </div>
              <div>
                <dt class="text-stone uppercase tracking-wider font-bold">Lokacija</dt>
                <dd class="text-ink">{region}{village ? `, ${village}` : ''}</dd>
              </div>
              <div>
                <dt class="text-stone uppercase tracking-wider font-bold">Premijera</dt>
                <dd class="text-ink">{dateLabel}</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>
